{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "protunel",
  "version": "0.1.0",
  "identifier": "com.admin.protunel",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "protunel",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDN0Y1QkFDMkZFMTM0OUQKUldTZE5PRXZyRnQvdk5xMm1vUkFQWkNwMWlPekdtbXNjWGdzM1BCUUpBbW11YkNlazE3TFdiVG8K",
      "endpoints": [
        "https://github.com/vrykolakas166/protunel/releases/latest/download/latest.json"
      ]
    }
  }
}
