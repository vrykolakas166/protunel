{
  "globalPaths": [
    "Cargo.lock",
    "Cargo.toml",
    "src-tauri/Cargo.lock",
    "src-tauri/Cargo.toml",
    "bun.lock",
    "package.json",
    ".github/workflows/**",
    "scripts/test-groups.json",
    "scripts/test-changed.ts",
    "scripts/testGroups.ts"
  ],
  "groups": {
    "frontend": {
      "paths": ["src/**", "tests/**", "package.json", "bun.lock", "tsconfig*.json", "vite.config.*"],
      "commands": [
        { "argv": ["bun", "x", "--no-install", "tsc", "--noEmit", "-p", "tsconfig.json"] },
        { "argv": ["bun", "test", "tests"] }
      ]
    },
    "rust": {
      "paths": ["src-tauri/**"],
      "commands": [
        { "argv": ["bun", "run", "build"] },
        { "cwd": "src-tauri", "argv": ["cargo", "check", "--locked"] },
        { "cwd": "src-tauri", "argv": ["cargo", "test", "--lib", "--locked"] }
      ]
    },
    "ssh-it": {
      "paths": [
        "src-tauri/src/ssh/**",
        "src-tauri/src/router/**",
        "src-tauri/src/tunnel.rs",
        "src-tauri/src/commands/connection.rs",
        "src-tauri/src/commands/files.rs",
        "src-tauri/src/commands/terminal*.rs",
        "src-tauri/tests/it/**",
        "src-tauri/src/it/**",
        "docker/it/**"
      ],
      "filters": {
        "it_copy": ["src-tauri/src/ssh/**/copy_across.rs", "src-tauri/src/it/copy.rs"],
        "it_sftp": ["src-tauri/src/ssh/sftp/**", "src-tauri/src/it/sftp.rs"],
        "it_router": ["src-tauri/src/router/**"],
        "it_tunnel": ["src-tauri/src/ssh/mod.rs", "src-tauri/src/tunnel.rs", "src-tauri/src/commands/connection.rs"]
      },
      "defaultFilter": "it_",
      "commands": [
        { "argv": ["bash", "-c", "mkdir -p docker/it/generated-keys && { [ -f docker/it/generated-keys/id_ed25519 ] || ssh-keygen -q -t ed25519 -N '' -C protunel-it -f docker/it/generated-keys/id_ed25519; }"] },
        { "argv": ["docker", "compose", "-f", "docker/it/compose.yaml", "up", "-d", "--build", "--wait"] },
        { "cwd": "src-tauri", "env": { "PROTUNEL_IT": "1" }, "argv": ["xvfb-run", "-a", "cargo", "test", "--lib", "--locked", "FILTER", "--", "--ignored", "--test-threads=1"] },
        { "always": true, "argv": ["bash", "-c", "docker compose -f docker/it/compose.yaml logs --no-color > ssh-it-compose.log 2>&1"] },
        { "always": true, "argv": ["docker", "compose", "-f", "docker/it/compose.yaml", "down"] }
      ]
    },
    "windows": {
      "paths": ["src-tauri/src/ssh/drag_out/**", "src-tauri/src/router/system_proxy.rs", "src-tauri/src/secrets.rs"],
      "commands": [
        { "argv": ["bun", "run", "build"] },
        { "cwd": "src-tauri", "argv": ["cargo", "test", "--lib", "--locked", "win_"] },
        { "cwd": "src-tauri", "argv": ["cargo", "test", "--lib", "--locked"] }
      ]
    }
  }
}
